{
  "format": "hypit.runtime-local@1",
  "dataRoot": ".hypit/runtimes/local",
  "endpoints": {
    "media.local": {
      "use": "@hypit/provider-media-local",
      "config": {
        "defaultConcurrency": 2
      }
    },
    "hyperframes.local": {
      "use": "@hypit/provider-hyperframes-local",
      "config": {
        "workers": 1,
        "defaultConcurrency": 1,
        "browserVersion": "152.0.7928.2"
      }
    }
  }
}